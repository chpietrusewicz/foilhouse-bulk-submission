# Copy to .env and fill in. Everything is optional except where noted.
PORT=3000
NODE_ENV=production

# Where submissions are emailed (default: foilhousetcg@gmail.com)
SUBMISSION_EMAIL=foilhousetcg@gmail.com

# SMTP for email notifications. Leave SMTP_HOST empty to only save to disk.
# For Gmail, use smtp.gmail.com, port 465, and an App Password (not your login password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Set to 1 when running behind a proxy/host that forwards client IPs (Render, Railway, nginx, etc.)
TRUST_PROXY=

# Where submissions and photos are stored (default: ./data/submissions)
DATA_DIR=
